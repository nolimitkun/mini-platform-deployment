{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 36,
  "tags": [
    "agentgateway",
    "projects"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "title": "Agentgateway projects",
  "uid": "agentgateway-projects",
  "description": "Per-project usage and cost of the model and tool gateway (docs/agentgateway.md). The project label comes from the API key.",
  "templating": {
    "list": [
      {
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource",
        "current": {}
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "definition": "label_values(agentgateway_requests_total, project)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "project",
        "label": "Project",
        "query": {
          "query": "label_values(agentgateway_requests_total, project)",
          "refId": "project"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Totals for the time range",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum(increase(agentgateway_requests_total{project=~\"$project\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Cost",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "agentgateway's own price table (the prices of the registry's model records). Self-hosted models cost nothing here.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum(increase(agentgateway_gen_ai_client_cost_usd_total{project=~\"$project\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Tokens",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{project=~\"$project\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Refused by policy",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Share of requests answered 403: OPA refused the model, Google API or tool.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "(sum(increase(agentgateway_requests_total{project=~\"$project\",status=\"403\"}[$__range])) or (0 * sum(increase(agentgateway_requests_total{project=~\"$project\"}[$__range])))) / sum(increase(agentgateway_requests_total{project=~\"$project\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Cost and tokens by project and model",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "One row per project and the model that served it. Requests sent as model auto show under the model OPA picked.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum by (project, gen_ai_request_model) (increase(agentgateway_gen_ai_client_cost_usd_total{project=~\"$project\"}[$__range]))",
          "legendFormat": "cost",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "B",
          "expr": "sum by (project, gen_ai_request_model) (increase(agentgateway_gen_ai_client_token_usage_sum{project=~\"$project\",gen_ai_token_type=\"input\"}[$__range]))",
          "legendFormat": "input",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "C",
          "expr": "sum by (project, gen_ai_request_model) (increase(agentgateway_gen_ai_client_token_usage_sum{project=~\"$project\",gen_ai_token_type=\"output\"}[$__range]))",
          "legendFormat": "output",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "D",
          "expr": "sum by (project, gen_ai_request_model) (increase(agentgateway_gen_ai_client_token_usage_count{project=~\"$project\",gen_ai_token_type=\"input\"}[$__range]))",
          "legendFormat": "requests",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "project": "Project",
              "gen_ai_request_model": "Model",
              "Value #A": "Cost (USD)",
              "Value #B": "Input tokens",
              "Value #C": "Output tokens",
              "Value #D": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Cost (USD)",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Requests by project and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum by (project, status) (rate(agentgateway_requests_total{project=~\"$project\"}[$__rate_interval]))",
          "legendFormat": "{{project}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Cost per hour by project and model",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "3600 * sum by (project, gen_ai_request_model) (rate(agentgateway_gen_ai_client_cost_usd_total{project=~\"$project\"}[$__rate_interval]))",
          "legendFormat": "{{project}} {{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Tokens per second by project and type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum by (project, gen_ai_token_type) (rate(agentgateway_gen_ai_client_token_usage_sum{project=~\"$project\"}[$__rate_interval]))",
          "legendFormat": "{{project}} {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Model mix (what auto picked shows here too)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "LLM requests per second by the model that served them, for the selected projects.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(agentgateway_gen_ai_client_token_usage_count{project=~\"$project\",gen_ai_token_type=\"input\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Model request duration, p50 and p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_request_model) (rate(agentgateway_gen_ai_server_request_duration_bucket{project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "p50 {{gen_ai_request_model}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(agentgateway_gen_ai_server_request_duration_bucket{project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "p95 {{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "MCP requests by project and method",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum by (project, method) (rate(agentgateway_mcp_requests_total{project=~\"$project\"}[$__rate_interval]))",
          "legendFormat": "{{project}} {{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
