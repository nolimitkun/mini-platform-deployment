# Local Mini Platform deployment configuration.
# Copy to .env, replace every required placeholder, and keep the file private.

# Deployment target and Git sources.
PROFILE=mini-platform
NS=mini-platform
ARGO_NS=argocd
CHARTS_REPO_URL=https://github.com/nolimitkun/mini-platform.git
CHARTS_REVISION=main
DEPLOY_REPO_URL=https://github.com/nolimitkun/mini-platform-deployment.git
DEPLOY_REVISION=main

# Required when the corresponding Vault path is first created or rotated.
# deploy-minikube.sh can load the first two from their default local files when
# these assignments remain empty.
HF_TOKEN=
DEEPSEEK_API_KEY=

# Fine-grained GitHub PAT: read-only Metadata, Contents, Pull requests, Actions.
HOLMES_GITHUB_TOKEN=

# Generate after Argo CD has synced accounts.holmes from argo-cd-values.yaml:
#   argocd account generate-token --account holmes
HOLMES_ARGOCD_AUTH_TOKEN=
